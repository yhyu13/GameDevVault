+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#pragma once
+
+#include "IModelContextProtocolTool.h"
+
+struct FModelContextProtocolSetPropertyTool : public IModelContextProtocolTool
+{
+	virtual FString GetName() const override;
+	virtual FString GetDescription() const override;
+	virtual TSharedPtr<FJsonObject> GetInputJsonSchema() const override;
+	virtual TSharedPtr<FJsonObject> GetOutputJsonSchema() const override;
+	virtual FModelContextProtocolToolResult Run(const TSharedPtr<FJsonObject>& Params) override;
+
+private:
+	/** Property paths that are explicitly forbidden (security). */
+	bool IsPropertyPathAllowed(const FString& InPath) const;
+
+	/** Parse a dot-separated property path into target object and final property. */
+	FProperty* ResolvePropertyPath(UObject* RootObject, const FString& InPath, void*& OutContainer) const;
+
+	/** Convert JSON value to FProperty-compatible string and set it. */
+	bool SetPropertyFromJsonValue(FProperty* Property, void* Container, const TSharedPtr<FJsonValue>& Value, FString& OutError) const;
+
+	/** Convert FProperty value to JSON value. */
+	TSharedPtr<FJsonValue> PropertyToJsonValue(FProperty* Property, void* Container) const;
+};
diff --git a/Engine/Plugins/Experimental/ModelContextProtocol/Source/ModelContextProtocolEditor/Private/ModelContextProtocolSetPropertyTool.cpp b/Engine/Plugins/Experimental/ModelContextProtocol/Source/ModelContextProtocolEditor/Private/ModelContextProtocolSetPropertyTool.cpp
